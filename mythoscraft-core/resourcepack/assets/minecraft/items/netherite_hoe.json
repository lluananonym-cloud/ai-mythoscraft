{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {"when": "harvest_sickle", "model": {"type": "minecraft:model", "model": "mythoscraft:item/harvest_sickle"}},
      {"when": "newyear_hoe", "model": {"type": "minecraft:model", "model": "mythoscraft:item/newyear_hoe"}},
      {"when": "pumpkin_scythe", "model": {"type": "minecraft:model", "model": "mythoscraft:item/pumpkin_scythe"}}
    ],
    "fallback": {
    "type": "minecraft:model",
    "model": "minecraft:item/netherite_hoe"
  }
  }
}
