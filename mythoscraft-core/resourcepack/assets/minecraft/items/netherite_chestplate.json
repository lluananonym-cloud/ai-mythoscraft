      {"when": "pumpkin_chestplate", "model": {"type": "minecraft:model", "model": "mythoscraft:item/pumpkin_chestplate"}},
      {"when": "sculk_chestplate", "model": {"type": "minecraft:model", "model": "mythoscraft:item/sculk_chestplate"}},
