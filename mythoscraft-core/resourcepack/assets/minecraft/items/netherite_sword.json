      {"when": "dragon_blade", "model": {"type": "minecraft:model", "model": "mythoscraft:item/dragon_blade"}},
      {"when": "frost_blade", "model": {"type": "minecraft:model", "model": "mythoscraft:item/frost_blade"}},
      {"when": "khopesh", "model": {"type": "minecraft:model", "model": "mythoscraft:item/khopesh"}},
