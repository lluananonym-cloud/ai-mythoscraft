      {"when": "pharaoh_helmet", "model": {"type": "minecraft:model", "model": "mythoscraft:item/pharaoh_helmet"}},
      {"when": "pumpkin_helmet", "model": {"type": "minecraft:model", "model": "mythoscraft:item/pumpkin_helmet"}},
      {"when": "sculk_helmet", "model": {"type": "minecraft:model", "model": "mythoscraft:item/sculk_helmet"}},
      {"when": "sky_helmet", "model": {"type": "minecraft:model", "model": "mythoscraft:item/sky_helmet"}},
