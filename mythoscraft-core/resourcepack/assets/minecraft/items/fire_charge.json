{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {"when": "meteor", "model": {"type": "minecraft:model", "model": "mythoscraft:item/meteor"}},
      {"when": "meteor_core", "model": {"type": "minecraft:model", "model": "mythoscraft:item/meteor_core"}}
    ],
    "fallback": {
    "type": "minecraft:model",
    "model": "minecraft:item/fire_charge"
  }
  }
}
