{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {"when": "berry_pie", "model": {"type": "minecraft:model", "model": "mythoscraft:item/berry_pie"}},
      {"when": "candy_corn", "model": {"type": "minecraft:model", "model": "mythoscraft:item/candy_corn"}},
      {"when": "fortune_cookie", "model": {"type": "minecraft:model", "model": "mythoscraft:item/fortune_cookie"}},
      {"when": "gingerbread", "model": {"type": "minecraft:model", "model": "mythoscraft:item/gingerbread"}},
      {"when": "lollipop", "model": {"type": "minecraft:model", "model": "mythoscraft:item/lollipop"}},
      {"when": "sky_cookie", "model": {"type": "minecraft:model", "model": "mythoscraft:item/sky_cookie"}},
      {"when": "sushi", "model": {"type": "minecraft:model", "model": "mythoscraft:item/sushi"}}
    ],
    "fallback": {
    "type": "minecraft:model",
    "model": "minecraft:item/cookie"
  }
  }
}
