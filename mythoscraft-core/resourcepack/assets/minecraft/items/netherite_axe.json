{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {"when": "chainsaw", "model": {"type": "minecraft:model", "model": "mythoscraft:item/chainsaw"}},
      {"when": "inferno_axe", "model": {"type": "minecraft:model", "model": "mythoscraft:item/inferno_axe"}},
      {"when": "newyear_axe", "model": {"type": "minecraft:model", "model": "mythoscraft:item/newyear_axe"}},
      {"when": "thunder_hammer", "model": {"type": "minecraft:model", "model": "mythoscraft:item/thunder_hammer"}},
      {"when": "timber_axe", "model": {"type": "minecraft:model", "model": "mythoscraft:item/timber_axe"}}
    ],
    "fallback": {
    "type": "minecraft:model",
    "model": "minecraft:item/netherite_axe"
  }
  }
}
